void main() {
    u32 speed;
    bsp_init();
    bsp_printf("Video Streaming 10G\r\n");
	init();
    bsp_uDelay(1000*1000);
    print_menu();
    while(1) {
        while (uart_readOccupancy(BSP_UART_TERMINAL))
        {
            console_main();
        }
        bsp_uDelay(10*1000);
    }
}
